NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Public address of the deployed site (no trailing slash). Used for canonical links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: Cloudflare Turnstile site key. Enables the spam check on owner sign-up and admin sign-in.
# Also enable Turnstile with its secret key in Supabase → Authentication → Attack Protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Card payments (Paymob). Server only: never prefix these with NEXT_PUBLIC_, and set them in
# Vercel → Settings → Environment Variables. Card mode can't be switched on in Admin → Policies until they're set.
# Webhook to set in the Paymob dashboard: https://your-domain.com/api/paymob/webhook
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
# Optional: the e-mail sent to Paymob when the guest's contact is a phone number.
PAYMOB_FALLBACK_EMAIL=
# Supabase → Project Settings → API → service_role. Used only by the payment routes on the server.
SUPABASE_SERVICE_ROLE_KEY=
